@startuml
title SmartHome Component Diagram

top to bottom direction

!include  https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml


'СУЩНОСТИ
Person(user, "Пользователь", "Пользователь системы")
Container(device, "Датчики", "", "Датчик умного дома") {
    Component(device_impl, "Датчик", "", "")
}
System_Boundary(SmartHomeSystemContainer, "Умный дом") {
    Container(user_interaction, "Взаимодействие с пользователем", "", "") {
        Component(api_gateway, "API Gateway", "Handles API requests", "")       
        Component(api, "API", "", "")
        Component(web_app, "Web App", "web app for users", "")
        Component(payment_processor, "PaymentService", "обработка платежей пользователя", "")
    } 
    Container_Boundary("message_broker", "Message Broker", "брокер сообщений",  ""){
        Component(kafka, "брокер сообщений", "Kafka", "")
    }
    Container(data_processing, "Модуль обработки данных", "Java") {
        Component(data_processor, "DataProcessor", "обрабатывает входящие данные", "")
        Component(event_store, "EventStore", "хранилище событий", "")
       
    }
    Container(analysis, "Модуль аналитики", "Java", "") {
        Component(analytic_service, "AnalyticService", "сервис анализа данных", "")
        Component(notification_service, "NotificationService", "сервис уведомлений", "")
        Component(control_service, "DeviceControlService", "сервис управления устройствами", "")
    }
}

System_Ext(bank, "Банковская система", "Обработка платежей")
Container(controller, "Контроллер", "", "Контроллер умного дома")

'СВЯЗИ
'пользователь
Rel(user, api_gateway, "Использует систему")

'пользовательское взаимодействие
Rel(api_gateway, kafka, "Запрос данных")
Rel(api_gateway, web_app, "Отображение данных")
Rel(api_gateway, api, "Отображение данных")
Rel(api_gateway, payment_processor, "Проведение оплаты")
Rel(payment_processor, bank, "Оплата услуг")

'kafka
Rel(kafka, user_interaction, "Предоставляет данные о доме")
Rel(kafka, data_processor, "Получение данных с датчиков ")
Rel(kafka, analytic_service, "Подписка на обновление данных")
Rel(kafka, notification_service, "Подписка на обновление данных")
Rel(kafka, control_service, "Подписка на обновление данных")

'датчик
Rel(device, kafka, "Отправляет данные измерений")

'обработка данных
Rel(data_processor, kafka, "Сохранение обработанных данных")
Rel(data_processor, event_store, "Сохранение событий")

'анализ данных
Rel(analytic_service, data_processor, "Обработанные данные")
Rel(analytic_service, event_store, "Обработанные данные")
Rel(notification_service, user, "Отправляет уведомления")
Rel(control_service, controller, "Управляющее воздействие")

@enduml
